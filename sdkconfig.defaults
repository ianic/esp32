CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

# static RX buffers use approximately 1.6 KB each, allocated during esp_wifi_init
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# ota
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_SPI_FLASH_AUTO_SUSPEND=n
# If CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is enabled, the new
# firmware is in a "pending verification" state on first boot. The
# application must call esp_ota_mark_app_valid_cancel_rollback() after
# confirming it can run normally (such as successfully connecting to
# WiFi and completing self-test). If not confirmed and the device
# reboots (such as power loss or crash), the bootloader will
# automatically roll back to the previous working firmware.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# optimizations
CONFIG_LWIP_IPV6=n
# CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# CONFIG_LOG_BOOTLOADER_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# CONFIG_COMPILER_OPTIMIZATION_NONE=n
# CONFIG_COMPILER_OPTIMIZATION_PERF=n
# CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
